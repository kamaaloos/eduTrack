{
  "name": "edutrack",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env CHOKIDAR_USEPOLLING=true EXPO_USE_FAST_RESOLVER=1 expo start",
    "start:clear": "cross-env CHOKIDAR_USEPOLLING=true EXPO_USE_FAST_RESOLVER=1 expo start --clear",
    "dev": "cross-env CHOKIDAR_USEPOLLING=true EXPO_USE_FAST_RESOLVER=1 expo start --clear",
    "start:tunnel": "cross-env CHOKIDAR_USEPOLLING=true EXPO_USE_FAST_RESOLVER=1 expo start --tunnel --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/sync-web-videos.mjs && cross-env EXPO_USE_FAST_RESOLVER=1 expo start --web",
    "prepare:web-videos": "node scripts/sync-web-videos.mjs",
    "encode:web-video": "node scripts/encode-web-video.mjs && node scripts/sync-web-videos.mjs",
    "build:web": "node scripts/sync-web-videos.mjs && expo export --platform web",
    "lint": "expo lint",
    "test": "jest",
    "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-edutrack-rules-test \"cross-env GCLOUD_PROJECT=demo-edutrack-rules-test jest --config jest.rules.config.js --runInBand --testTimeout=30000\"",
    "onboard:school": "node scripts/onboard-school.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "typecheck:app": "node scripts/typecheck-app.mjs",
    "playwright:install": "playwright install chromium",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preci:e2e": "playwright install chromium",
    "ci:e2e": "npm run build:web && playwright test",
    "ci": "npm test && npm run test:rules && npm run lint && npm run typecheck && npm run typecheck:app",
    "build:android:preview": "eas build -p android --profile preview",
    "build:android:production": "eas build -p android --profile production",
    "build:ios:preview": "eas build -p ios --profile preview",
    "build:ios:production": "eas build -p ios --profile production",
    "build:ios:development": "eas build -p ios --profile development"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.3.16",
    "@xmldom/xmldom": "^0.9.10",
    "expo": "~54.0.35",
    "expo-application": "~7.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.12.1",
    "i18next": "^26.2.0",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-barcode-svg": "^0.0.15",
    "react-native-chart-kit": "^6.12.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.0.0",
    "jest": "^29.7.0",
    "@playwright/test": "^1.55.0",
    "serve": "^14.2.4",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  },
  "private": true
}
