# Copy to `.env.e2e` for local Playwright runs (never commit real passwords).
# CI: add the same keys as GitHub Actions secrets.

# Static web build must reach your registry + school Firebase projects.
# Use the same EXPO_PUBLIC_* values as `.env` when running `npm run build:web`.

# School picker — country/city name only (UI appends " (count)", e.g. Finland (2))
E2E_SCHOOL_COUNTRY=Finland
E2E_SCHOOL_CITY=Helsinki
E2E_SCHOOL_NAME=Demo School

# Role accounts in that school (mustChangePassword should be false)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=

# Optional: use an already-running server (Expo `npm run web` on :8081, or static `serve dist` on :4173).
# Leave unset for the default: Playwright runs `serve dist` on http://127.0.0.1:4173 after `npm run build:web`.
# E2E_BASE_URL=http://127.0.0.1:4173
# E2E_BASE_URL=http://localhost:8081
