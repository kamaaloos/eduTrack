# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
functions/lib/
school-functions/lib/

# env files
.env
.env*.local

# Google Android developer verification (package-specific snippet)
assets/adi-registration.properties

# Firebase / service account secrets (never commit)
serviceAccountKey.json
serviceAccount*.json
!serviceAccountKey.example.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
**/firebase-adminsdk*.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
# Local EAS build inspection output (hundreds of generated files — never commit)
.eas-inspect/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.env.e2e

# Local typecheck scratch
tsc-app.txt
tsc-errors.txt
tsconfig-resolved.json

.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo

app-example

# local test output (optional)
coverage/

# generated native folders
/ios
/android

# Web promo videos (copied from assets/ by scripts/sync-web-videos.mjs)
public/videos/*.mp4

# Full-size promo sources — keep locally; run npm run encode:web-video (not for GitHub)
assets/edutrack.mp4
assets/edutrack-ar.mp4
assets/edutrack-promo.mp4
assets/edutrack2.mp4
assets/edutrack-promo2-full.mp4
assets/dugsi.mp4
assets/dugsi-ar.mp4
assets/dugsi-so.mp4
assets/dugsi-fi.mp4

# High-res brand artwork — keep locally; run npm run prepare:brand-images
assets/images/dugsi-icon.source.png
assets/images/dugsi-logo.source.png

# Local debug logs
crash-full.txt