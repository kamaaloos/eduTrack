# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
functions/lib/
school-functions/lib/

# env files
.env
.env*.local

# Google Android developer verification (package-specific snippet)
assets/adi-registration.properties

# Firebase / service account secrets (never commit)
serviceAccountKey.json
serviceAccount*.json
!serviceAccountKey.example.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
**/firebase-adminsdk*.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
# Local EAS build inspection output (hundreds of generated files — never commit)
.eas-inspect/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo

app-example

# local test output (optional)
coverage/

# generated native folders
/ios
/android

# Web promo videos (copied from assets/ by scripts/sync-web-videos.mjs)
public/videos/*.mp4

# Full-size promo sources — keep locally; run npm run encode:web-video (not for GitHub)
assets/edutrack2.mp4
assets/edutrack-promo2-full.mp4

# Local debug logs
crash-full.txt