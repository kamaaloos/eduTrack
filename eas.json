{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "development-dugsi": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_APP_BRAND": "dugsi",
        "EXPO_PUBLIC_APP_DISPLAY_NAME": "Dugsi",
        "EXPO_PUBLIC_APP_SCHEME": "dugsi",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.maylesoft.dugsi",
        "EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER": "com.maylesoft.dugsi"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/**/mapping.txt"
      ],
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "distribution": "store"
      }
    },
    "preview-dugsi": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_BRAND": "dugsi",
        "EXPO_PUBLIC_APP_DISPLAY_NAME": "Dugsi",
        "EXPO_PUBLIC_APP_SCHEME": "dugsi",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.maylesoft.dugsi",
        "EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER": "com.maylesoft.dugsi"
      }
    },
    "production-dugsi": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_BRAND": "dugsi",
        "EXPO_PUBLIC_APP_DISPLAY_NAME": "Dugsi",
        "EXPO_PUBLIC_APP_SCHEME": "dugsi",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.maylesoft.dugsi",
        "EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER": "com.maylesoft.dugsi"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production-dugsi": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
