{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "distribution": "store"
      }
    },
    "preview-dugsi": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_BRAND": "dugsi",
        "EXPO_PUBLIC_APP_DISPLAY_NAME": "Dugsi",
        "EXPO_PUBLIC_APP_SCHEME": "dugsi",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.maylesoft.dugsi",
        "EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER": "com.maylesoft.dugsi",
        "EXPO_PUBLIC_REGISTRY_API_KEY": "",
        "EXPO_PUBLIC_REGISTRY_AUTH_DOMAIN": "",
        "EXPO_PUBLIC_REGISTRY_PROJECT_ID": "",
        "EXPO_PUBLIC_REGISTRY_STORAGE_BUCKET": "",
        "EXPO_PUBLIC_REGISTRY_MESSAGING_SENDER_ID": "",
        "EXPO_PUBLIC_REGISTRY_APP_ID": ""
      }
    },
    "production-dugsi": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_BRAND": "dugsi",
        "EXPO_PUBLIC_APP_DISPLAY_NAME": "Dugsi",
        "EXPO_PUBLIC_APP_SCHEME": "dugsi",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.maylesoft.dugsi",
        "EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER": "com.maylesoft.dugsi",
        "EXPO_PUBLIC_REGISTRY_API_KEY": "",
        "EXPO_PUBLIC_REGISTRY_AUTH_DOMAIN": "",
        "EXPO_PUBLIC_REGISTRY_PROJECT_ID": "",
        "EXPO_PUBLIC_REGISTRY_STORAGE_BUCKET": "",
        "EXPO_PUBLIC_REGISTRY_MESSAGING_SENDER_ID": "",
        "EXPO_PUBLIC_REGISTRY_APP_ID": ""
      }
    }
  }
}
