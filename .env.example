# --- Platform brand (build-time) ---
# eduTrack (default) or Dugsi — set before `eas build` or in EAS profile env.
# EXPO_PUBLIC_APP_BRAND=edutrack
# EXPO_PUBLIC_APP_DISPLAY_NAME=eduTrack
# EXPO_PUBLIC_APP_SCHEME=edutrack
# EXPO_PUBLIC_ANDROID_PACKAGE=com.maylesoft.edutrack
# EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.maylesoft.edutrack
#
# Dugsi example (use eas build --profile preview-dugsi):
# EXPO_PUBLIC_APP_BRAND=dugsi
# EXPO_PUBLIC_APP_DISPLAY_NAME=Dugsi
# EXPO_PUBLIC_APP_SCHEME=dugsi
# EXPO_PUBLIC_ANDROID_PACKAGE=com.maylesoft.dugsi
# EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.maylesoft.dugsi
# Dugsi can share the same EXPO_PUBLIC_REGISTRY_* as eduTrack (same school list).
# Only set separate Dugsi registry vars if you want a different Firebase school list.

# Registry project: hosts the public school list (schoolRegistry collection).
# If omitted, EXPO_PUBLIC_FIREBASE_* is used as the registry.
EXPO_PUBLIC_REGISTRY_API_KEY=
EXPO_PUBLIC_REGISTRY_AUTH_DOMAIN=
EXPO_PUBLIC_REGISTRY_PROJECT_ID=
EXPO_PUBLIC_REGISTRY_STORAGE_BUCKET=
EXPO_PUBLIC_REGISTRY_MESSAGING_SENDER_ID=
EXPO_PUBLIC_REGISTRY_APP_ID=

# Default / fallback school Firebase project (also used when schoolRegistry is empty)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dev: faster Metro resolution (Expo)
EXPO_USE_FAST_RESOLVER=1

# Windows: Metro often misses file saves without polling — enables live reload
CHOKIDAR_USEPOLLING=true

# Optional: show platform admin sign-in link on school picker (default: hidden; tap logo 5×)
# EXPO_PUBLIC_SHOW_PLATFORM_ADMIN_LINK=true
