{
  "expo": {
    "name": "eduTrack",
    "slug": "eduTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edutrack",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maylesoft.edutrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "package": "com.maylesoft.edutrack",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-screen.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/splash-screen.png",
            "resizeMode": "cover",
            "backgroundColor": "#FFFFFF",
            "enableFullScreenImage_legacy": true
          },
          "ios": {
            "image": "./assets/images/splash-screen.png",
            "resizeMode": "cover",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow eduTrack to access your photos to set your profile picture."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1E3A8A",
          "defaultChannel": "default"
        }
      ],
      "./plugins/withAdiRegistration"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d115957-ea1b-41e7-90be-30b91ef386ac"
      }
    },
    "owner": "kamaaloos"
  }
}
